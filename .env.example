NEXT_PUBLIC_PYTHON_SERVER_URL=
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_FRONTEND_URL=
NEXT_PUBLIC_CHATBOT_SCRIPT_SRC = 
NEXT_PUBLIC_REFERENCEID = 
NEXT_PUBLIC_EMBED_SCRIPT_ID = 
NEXT_PUBLIC_EMBED_SCRIPT_SRC = 
NEXT_PUBLIC_PROXY_URL=

# Where the ranger-update agent's tools call this app back. Optional: falls back to
# TELEGRAM_WEBHOOK_BASE_URL, then NEXT_PUBLIC_FRONTEND_URL. Set it to a tunnel during
# local development — the agent runs on GTWY's servers and cannot reach localhost, and
# pointing it at the hosted app would write channel documents to the hosted database
# while a local UI reads its own.
RANGER_PUBLIC_URL=

# Scheduler (EasyCron). The API key is server-only — it is never sent to the browser
# and never stored in a tool's configuration. RANGER_PUBLIC_URL above doubles as the
# origin EasyCron calls back on, so it must be publicly reachable for schedules to
# fire at all; on a bare localhost server the schedule is created and never runs.
EASYCRON_API_KEY=
# Optional: EasyCron dashboard group all jobs are created under, e.g.
# https://www.easycron.com/cron-jobs/index?group_id=95890
EASYCRON_GROUP_ID=
# How many schedules one ranger may hold. Defaults to 10.
SCHEDULER_MAX_PER_RANGER=
# Guards /api/scheduler/reconcile, which spans every org and so is not session-authed.
# Unset means that route answers 404.
SCHEDULER_ADMIN_KEY=
